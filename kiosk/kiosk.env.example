# Copy to kiosk.env (gitignored) or /etc/thinksmart-kiosk.env and chmod 600.
# thinksmart-face.py and thinksmart-wake.py load these if the process env is unset.
# Replace 192.0.2.10 with the companion IPv4. The face/wake refuse to start on that placeholder.

VOICE_HOST=192.0.2.10
FACE_HOST=192.0.2.10
CLOCK_TZ=America/Chicago
SCREEN_IDLE_SEC=60
